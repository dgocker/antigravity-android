# Antigravity Gateway Environment Configuration

# Optional master auth token for administrative / script access
# Generate with: openssl rand -hex 32
AUTH_TOKEN=

# Host and port to bind uvicorn
HOST=127.0.0.1
PORT=8765

# Maximum concurrent background runs (headless mode)
MAX_CONCURRENT_RUNS=2

# Path to gateway SQLite database
DB_PATH=./gateway.db

# Path to Antigravity CLI databases and brain directories (defaults to ~/.gemini/antigravity-cli)
# CONVERSATION_SUMMARIES_DB=/root/.gemini/antigravity-cli/conversation_summaries.db
# BRAIN_DIR=/root/.gemini/antigravity-cli/brain

# Uploads directory for images, voice messages, and attachments
UPLOADS_DIR=/root/agy-uploads
UPLOAD_MAX_SIZE_BYTES=52428800

# Allowed workspace roots for file navigation and project creation (comma-separated)
ALLOWED_WORKSPACE_ROOTS=/root,/root/agy-uploads

# Maximum allowed file size for reading raw files (in bytes, default 5MB)
FILE_MAX_SIZE_BYTES=5242880

# Path to Antigravity CLI binary
AGY_BIN=/root/.local/bin/agy
